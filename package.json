{
  "name": "groop",
  "version": "0.1.0",
  "private": true,
  "description": "Group chat with multiple LLMs that decide when to speak",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "start": "npm run build:web && tsx src/server/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "openai": "^4.104.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
